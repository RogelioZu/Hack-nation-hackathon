# Copiar a .env (raíz del repo, lo usa analysis/). Nunca commitear valores reales.
SUPABASE_URL=https://xnbruiprrxradfidoleu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Copiar estas dos a web/.env.local (solo lectura, seguras en el navegador bajo RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xnbruiprrxradfidoleu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Omnigent usa el harness codex con la sesión de ChatGPT de `codex login`: no hace falta OPENAI_API_KEY.
# Omnigent NO lee .env: cargarlo antes de correr con: set -a; source .env; set +a

# Bright Data (opcional): búsqueda web en vivo del Literature Agent (tool search_web). Zona de tipo SERP API.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=

# Intérprete del motor de experimentos (opcional; por defecto .venv-experiments/bin/python).
EXPERIMENT_PYTHON=
