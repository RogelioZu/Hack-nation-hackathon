# Copiar a .env (raíz del repo, lo usa analysis/). Nunca commitear valores reales.
SUPABASE_URL=https://xnbruiprrxradfidoleu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Copiar estas dos a web/.env.local (solo lectura, seguras en el navegador bajo RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xnbruiprrxradfidoleu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LLM de los agentes: Databricks Free Edition (workspace dbc-1548c90f-c9ac), endpoint
# databricks-gpt-oss-120b vía el provider `databricks-serving` de ~/.omnigent/config.yaml,
# que lee este token (api_key_ref: env:DATABRICKS_TOKEN). Usar un PAT de Databricks
# (User Settings → Developer → Access tokens). Un token OAuth de `databricks auth token`
# también sirve, pero caduca en ~1 h. Setup completo: MEMORY.md §5 "Omnigent en Windows".
DATABRICKS_TOKEN=
# Omnigent NO lee .env: cargarlo antes de correr con: set -a; source .env; set +a
# En Windows, además: PYTHONUTF8=1 (si no, el túnel del host falla con 'charmap' codec).

# Bright Data (opcional): búsqueda web en vivo del Literature Agent (tool search_web). Zona de tipo SERP API.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=

# Intérprete del motor de experimentos (opcional; por defecto .venv-experiments/bin/python).
# En Windows es obligatorio: .venv-experiments/Scripts/python.exe
EXPERIMENT_PYTHON=
